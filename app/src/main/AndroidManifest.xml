<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required by tech stack and PRS: ZERO INTERNET -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".BirtuApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link / shortcut support -->
            <intent-filter>
                <action android:name="com.birtucansoftware.birtusince.ACTION_OPEN_ITEM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Capture Activity for Quick Settings Tile -->
        <activity
            android:name=".ui.tile.QuickCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickCapture"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- Quick Settings Tile -->
        <service
            android:name=".ui.tile.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Boot Receiver for AlarmManager exact alarms re-registration -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Reminder Alarm Receiver -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!-- Notification Action Receiver (Start Over from Notification) -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- Home Screen AppWidget Provider (2x2 and 4x2) -->
        <receiver
            android:name=".widget.BirtuAppWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/birtu_widget_info" />
        </receiver>

        <!-- Direct Widget Start Over Action Receiver (without opening app) -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

    </application>

</manifest>
